    "dotenv": "^16.4.7",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.0.6",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
